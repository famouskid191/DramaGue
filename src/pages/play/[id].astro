---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.jsx';
import PlayerApp from '../../components/PlayerApp.jsx';
import Footer from '../../components/Footer.jsx';
import videos from '../../../public/videos.json';

export async function getStaticPaths() {
  return videos.map((video) => {
    const regExp = /^.*((youtu.be\/)|(v\/)|(\/u\/\w\/)|(embed\/)|(watch\?))\??v?=?([^#&?]*).*/;
    const match = video.url.match(regExp);
    const ytId = (match && match[7].length === 11) ? match[7] : null;
    const thumbnailUrl = ytId ? `https://img.youtube.com/vi/${ytId}/maxresdefault.jpg` : undefined;

    return {
      params: { id: video.id.toString() },
      props: { video, thumbnailUrl },
    };
  });
}

interface Props {
  video: {
    id: number;
    judul: string;
    url: string;
    kategori: string;
    tag: string[];
  };
  thumbnailUrl: string | undefined;
}

const { video, thumbnailUrl } = Astro.props;
---

<Layout 
  title={`${video.judul} - Drama Gue`} 
  description={`Nonton ${video.judul} kategori ${video.kategori} di Drama Gue secara gratis.`}
  image={thumbnailUrl}
>
  <Navbar client:load />
  <PlayerApp client:load videoId={video.id} />
  <Footer />
</Layout>