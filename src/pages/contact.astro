---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
---

<Layout title="Contact Us - Drama Gue">
  <Navbar client:load />
  <main class="flex-grow max-w-4xl mx-auto px-4 py-12 w-full">
    <h1 class="text-3xl font-bold mb-6 text-gray-900 dark:text-white">Hubungi Kami</h1>
    <div class="bg-white dark:bg-[#1a1a1a] p-8 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm">
      <form class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Nama Representatif</label>
          <input type="text" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-[#2d2d2d] dark:text-white focus:ring-2 focus:ring-red-500 outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Jalur Komunikasi Email</label>
          <input type="email" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-[#2d2d2d] dark:text-white focus:ring-2 focus:ring-red-500 outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Rincian Pertanyaan</label>
          <textarea rows="5" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-[#2d2d2d] dark:text-white focus:ring-2 focus:ring-red-500 outline-none transition-colors"></textarea>
        </div>
        <button type="button" class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg w-full transition-colors shadow-md">Kirimkan Notifikasi</button>
      </form>
    </div>
  </main>
  <Footer />
</Layout>